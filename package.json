{
  "name": "houjian-homepage",
  "private": true,
  "version": "1.0.0",
  "description": "Personal academic homepage with paper subpages and PDF reader",
  "scripts": {
    "check:syntax": "node scripts/check-syntax.js",
    "check:data": "node scripts/build-site-data.js --check && node scripts/validate-site.js && node scripts/generate-paper-toc.js --check && node scripts/sync-paper-seo.js --check",
    "check:acceptance": "node scripts/acceptance-check.js",
    "check:contrast": "node scripts/check-contrast.js",
    "data:build": "node scripts/build-site-data.js --write",
    "seo:sync": "node scripts/sync-paper-seo.js --write",
    "metadata:enrich": "node scripts/enrich-metadata.js --write-cache",
    "test:ui": "playwright test",
    "test:ui:core": "playwright test tests/ui/regression.spec.js tests/ui/accessibility.spec.js",
    "test:a11y": "playwright test tests/ui/accessibility.spec.js",
    "test:visual": "playwright test tests/ui/visual.spec.js",
    "lighthouse": "node scripts/run-lighthouse-check.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "lighthouse": "^13.4.1"
  }
}
