<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  主页项目 · 定时门禁（launchd LaunchAgent）

  由 scripts/ops/macmini-bootstrap.sh 渲染：
    __REPO_DIR__ -> 仓库绝对路径
    __LOG_DIR__  -> 日志目录（默认 ~/Library/Logs/homepage-ci）
    __PATH__     -> 渲染时的 PATH（保证能定位 brew 的 node/npm）

  只跑 --quick：数据/结构/对比度/验收门禁不依赖图形会话，适合无人值守。
  Playwright 与 Lighthouse 需要已登录的图形会话，请手动跑 --full。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.houjian.homepage-ci</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__REPO_DIR__/scripts/ops/local-ci.sh</string>
		<string>--quick</string>
		<string>--pull</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__REPO_DIR__</string>

	<!-- 每小时跑一次；睡眠错过的间隔会在唤醒后合并执行一次 -->
	<key>StartInterval</key>
	<integer>3600</integer>

	<!-- 登录时不立刻跑一遍（想开机即跑改成 <true/>） -->
	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>__LOG_DIR__/launchd-ci.out.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/launchd-ci.err.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PATH__</string>
		<key>CI</key>
		<string>1</string>
	</dict>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>