<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  主页项目 · 内网预览静态服务（Caddy，launchd LaunchAgent）

  由 scripts/ops/macmini-bootstrap.sh 渲染：
    __CADDY_BIN__    -> caddy 可执行文件绝对路径（brew 安装）
    __CADDY_CONFIG__ -> 渲染后的 Caddyfile 路径

  纯内网用途：监听高位端口、无证书、不对外网开放。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.houjian.homepage-preview</string>

	<key>ProgramArguments</key>
	<array>
		<string>__CADDY_BIN__</string>
		<string>run</string>
		<string>--config</string>
		<string>__CADDY_CONFIG__</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>StandardOutPath</key>
	<string>__LOG_DIR__/caddy.out.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/caddy.err.log</string>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>